{
  "name": "@arshdelight/loop-react",
  "version": "0.1.1",
  "description": "Agent UI for loop: ToolRow, tool renderer registry with Generic Fallback, markdown renderer (highlight.js / katex / mermaid), bilingual i18n, theming, renderer workbench",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./workbench": {
      "import": "./dist/workbench/index.js",
      "types": "./dist/workbench/index.d.ts"
    },
    "./theme.css": "./dist/theme.css",
    "./markdown.css": "./dist/markdown.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "ai",
    "agent",
    "react",
    "ai-sdk",
    "vercel-ai-sdk",
    "tool-rendering",
    "markdown",
    "tailwindcss",
    "chat-ui"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown && node -e \"const{copyFileSync}=require('fs');copyFileSync('src/theme.css','dist/theme.css');copyFileSync('src/markdown.css','dist/markdown.css')\""
  },
  "peerDependencies": {
    "@arshdelight/loop-core": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@arshdelight/loop-core": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0"
  }
}
